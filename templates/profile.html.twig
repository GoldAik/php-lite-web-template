<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
</head>
<body>

    {% if not user %}
        There is no such profile
    {% endif %}

    {% if user %}
        Welcome on profile {{user.username}} <br>

        id: {{user.id}}<br>
        username: {{user.username}}<br>
        email: {{user.email}}<br>
        password hash: {{user.passwordHash}}<br>

    {% endif %}

</body>
</html>